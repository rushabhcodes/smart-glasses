# Build-only custom module profile; GPIO mapping is PROPOSED, not bench verified.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=n
CONFIG_SPIRAM_MEMTEST=y
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y
# S3 has no C5-style hardware ECDSA signing peripheral.
CONFIG_MBEDTLS_HARDWARE_ECDSA_SIGN=n
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_HOMEHUB_LED_BACKEND_NONE=y
CONFIG_HOMEHUB_BUTTON_GPIO=1
CONFIG_MUSE_BOARD_NONE=y
CONFIG_HOMEHUB_SMART_GLASSES=y
CONFIG_HOMEHUB_VOICE=y
CONFIG_MUSE_REALTIME_VOICE=y
CONFIG_MUSE_REALTIME_VOICE_AEC_DUPLEX=n
CONFIG_SG_DEFAULT_VOLUME=10
CONFIG_SG_MAX_VOLUME=20
CONFIG_SG_RECORD_LED_ACTIVE_HIGH=y
CONFIG_SG_AMP_ACTIVE_HIGH=y
CONFIG_SG_CAMERA_MAX_JPEG_BYTES=32768
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_muse_8mb.csv"
CONFIG_CAMERA_PSRAM_DMA=y
# Compile without credentials; serial provisioning is a separate future step.
CONFIG_GADGET_SDK_TOKEN=""
CONFIG_GADGET_SDK_TOKEN_WARN=y
CONFIG_HOMEHUB_OTA_ENABLED=n
# Re-enable watchdogs disabled by the upstream C5 throughput defaults.
CONFIG_ESP_INT_WDT=y
CONFIG_ESP_TASK_WDT_EN=y
