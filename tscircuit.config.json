{
  "$schema": "https://cdn.jsdelivr.net/npm/@tscircuit/cli/types/tscircuit.config.schema.json",
  "mainEntrypoint": "src/flex/main-flex.circuit.tsx",
  "ignoredFiles": [
    "node_modules/**",
    "dist/**",
    "checks/**",
    "firmware/build/**",
    "firmware/logs/**",
    "**/__pycache__/**",
    "**/*.pyc",
    "**/*.log",
    "**/sdkconfig",
    "**/sdkconfig.old",
    "**/sdkconfig.local*"
  ],
  "previewComponentPath": "src/flex/main-flex.circuit.tsx",
  "alwaysUseLatestTscircuitOnCloud": false,
  "useCloudAutorouting": false,
  "includeBoardFiles": [
    "src/flex/main-flex.circuit.tsx",
    "src/flex/secondary-flex.circuit.tsx",
    "src/camera-carrier/camera-carrier.circuit.tsx",
    "src/enclosure/glasses-enclosure.circuit.tsx"
  ],
  "build": {
    "circuitJson": true,
    "previewImages": true,
    "glbs": true,
    "routingDisabled": true
  },
  "siteDefaultComponentPath": "src/flex/main-flex.circuit.tsx"
}
