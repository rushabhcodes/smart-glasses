{
  "name": "smart-glasses",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "WORK IN PROGRESS: unrouted two-board flex smart-glasses study and separate default-off OV5640 AF carrier; battery, camera integration, frame fit and physical validation unresolved.",
  "license": "UNLICENSED",
  "engines": {
    "node": "24.x",
    "bun": ">=1.3.3"
  },
  "scripts": {
    "dev": "tsci dev src/main-board/main-board.circuit.tsx",
    "dev:main": "tsci dev src/main-board/main-board.circuit.tsx",
    "dev:secondary": "tsci dev src/secondary-board/secondary-board.circuit.tsx --port 3021",
    "typecheck": "tsc --noEmit",
    "build:main": "tsci build src/main-board/main-board.circuit.tsx --routing-disabled --disable-parts-engine",
    "build:secondary": "tsci build src/secondary-board/secondary-board.circuit.tsx --routing-disabled --disable-parts-engine",
    "build": "npm run build:main && npm run build:secondary",
    "check:netlist": "node scripts/check-boards.mjs netlist",
    "check:schematic": "node scripts/check-boards.mjs schematic-placement",
    "check:placement": "node scripts/check-boards.mjs placement",
    "check:source": "node scripts/check-boards.mjs source",
    "render:main": "tsci build src/main-board/main-board.circuit.tsx --svgs --pcb-png --schematic-png --routing-disabled --disable-parts-engine",
    "render:secondary": "tsci build src/secondary-board/secondary-board.circuit.tsx --svgs --pcb-png --schematic-png --routing-disabled --disable-parts-engine",
    "render": "npm run render:main && npm run render:secondary",
    "validate": "npm run typecheck && npm run check:netlist && npm run check:schematic && npm run check:placement && npm run build && npm run check:main-core && npm run check:peripherals",
    "firmware:bootstrap": "bash firmware/scripts/bootstrap.sh",
    "firmware:prepare": "python3 firmware/scripts/prepare.py",
    "firmware:build": "bash firmware/scripts/build.sh build",
    "firmware:test": "bash firmware/scripts/build.sh test",
    "firmware:size": "bash firmware/scripts/build.sh size",
    "check:main-core": "node scripts/check-main-core.mjs",
    "check:peripherals": "node scripts/check-peripherals.mjs",
    "report:routing-feasibility": "node scripts/report-routing-feasibility.mjs",
    "report:power-budget": "node scripts/report-power-budget.mjs",
    "report:camera-interface": "node scripts/report-camera-interface.mjs",
    "audit:bom": "bun scripts/audit-bom.mjs",
    "render:progress": "bun scripts/render-progress.mjs",
    "build:enclosure": "tsci build src/enclosure/glasses-enclosure.circuit.tsx --routing-disabled --disable-parts-engine",
    "export:enclosure": "bun scripts/build-glasses-enclosure.ts --verify",
    "plan:flex": "node scripts/plan-flex.mjs && python scripts/refine-flex-backing.py",
    "build:flex:main": "tsci build src/flex/main-flex.circuit.tsx --ignore-config --routing-disabled --disable-parts-engine",
    "build:flex:secondary": "tsci build src/flex/secondary-flex.circuit.tsx --ignore-config --routing-disabled --disable-parts-engine",
    "build:flex": "npm run build:flex:main && npm run build:flex:secondary",
    "check:flex": "node scripts/check-flex.mjs",
    "check:flex-backing": "python scripts/check-flex-backing.py",
    "render:flex": "bun scripts/render-flex-progress.ts",
    "export:flex-layout": "node scripts/export-flex-layout.mjs",
    "build:camera-carrier": "tsci build src/camera-carrier/camera-carrier.circuit.tsx --ignore-config --routing-disabled --disable-parts-engine",
    "check:camera-carrier": "node scripts/check-camera-carrier.mjs",
    "render:camera-carrier": "bun scripts/render-camera-carrier.ts",
    "plan:slim": "node scripts/plan-slim.mjs placement",
    "build:slim:main": "tsci build src/slim/main-slim.circuit.tsx --ignore-config --routing-disabled --disable-parts-engine",
    "build:slim:secondary": "tsci build src/slim/secondary-slim.circuit.tsx --ignore-config --routing-disabled --disable-parts-engine",
    "build:slim": "npm run build:slim:main && npm run build:slim:secondary",
    "plan:slim-backing": "node scripts/plan-slim.mjs backing && python scripts/refine-flex-backing.py src/slim/layout.json mechanical/slim --connected-core",
    "check:slim": "node scripts/check-slim.mjs && python scripts/check-flex-backing.py src/slim/layout.json slim mechanical/slim",
    "render:slim": "bun scripts/render-flex-progress.ts dist/slim-review slim"
  },
  "dependencies": {
    "react": "19.3.1"
  },
  "devDependencies": {
    "@tscircuit/props": "0.0.712",
    "@types/node": "24.10.0",
    "@types/react": "19.3.0",
    "tscircuit": "0.0.3033",
    "typescript": "5.9.3",
    "circuit-json-to-gltf": "0.0.151",
    "poppygl": "0.0.37"
  }
}
